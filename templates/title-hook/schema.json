{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kicker": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "description": "左上角标签（如：TOKEN 计费）"
    },
    "headline": {
      "type": "string",
      "minLength": 2,
      "maxLength": 14,
      "description": "主标题（逐字上浮）"
    },
    "subline": {
      "type": "string",
      "minLength": 2,
      "maxLength": 24,
      "description": "副标题（一句话说明）"
    },
    "variant": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2,
      "labels": [
        "居中大字",
        "分栏卡片",
        "横幅带"
      ],
      "description": "版式变体（缺省按旁白哈希自动分配）"
    }
  },
  "required": [
    "kicker",
    "headline",
    "subline"
  ],
  "additionalProperties": false
}