{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kicker": { "type": "string", "minLength": 2, "maxLength": 16, "description": "左上角标签" },
    "headline": { "type": "string", "minLength": 2, "maxLength": 16, "description": "标题" },
    "core_label": { "type": "string", "minLength": 1, "maxLength": 8, "description": "轮心主题，如「我的一天」" },
    "slices": {
      "type": "array", "minItems": 3, "maxItems": 6,
      "items": { "type": "string", "minLength": 2, "maxLength": 18 },
      "description": "时段弧，格式「活动|小时数|小注」，小时数合计尽量接近 24"
    },
    "note": { "type": "string", "minLength": 0, "maxLength": 22, "description": "注解（可留空）" }
  },
  "required": ["kicker", "headline", "core_label", "slices"],
  "additionalProperties": false
}
