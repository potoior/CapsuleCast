{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kicker": { "type": "string", "minLength": 2, "maxLength": 16, "description": "左上角标签" },
    "headline": { "type": "string", "minLength": 2, "maxLength": 16, "description": "标题" },
    "steps": {
      "type": "array", "minItems": 3, "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string", "minLength": 2, "maxLength": 8, "description": "步骤名" },
          "detail": { "type": "string", "minLength": 2, "maxLength": 14, "description": "步骤说明" }
        },
        "required": ["label", "detail"],
        "additionalProperties": false
      },
      "description": "步骤（3-5 个）"
    }
  },
  "required": ["kicker", "headline", "steps"],
  "additionalProperties": false
}
