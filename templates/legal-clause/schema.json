{
  "type": "object",
  "properties": {
    "kicker": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "description": "左上角眉题，如：避坑指南"
    },
    "headline": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "description": "主标题，点出最毒的一条，如：租房合同最毒的一条"
    },
    "contract_name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 14,
      "description": "合同纸抬头名称，如：房屋租赁合同"
    },
    "clauses": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 4,
        "maxLength": 18,
        "description": "第X条|条款摘要"
      },
      "description": "条款列表，每项为「第X条|条款摘要」格式"
    },
    "highlights": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 6,
        "description": "要加红色重点线的关键词，需出现在条款摘要里"
      },
      "description": "条款中的重点词，渲染时加红色下划重点线"
    },
    "stamp": {
      "type": "string",
      "minLength": 2,
      "maxLength": 6,
      "description": "末尾圆形印章文字，如：此条有坑"
    },
    "verdict": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "description": "一句话结论建议，如：签字前划掉，能救你一个月房租"
    },
    "note": {
      "type": "string",
      "minLength": 0,
      "maxLength": 22,
      "description": "可选底部小字备注，留空则不显示"
    }
  },
  "required": ["kicker", "headline", "contract_name", "clauses", "highlights", "stamp", "verdict"],
  "additionalProperties": false
}
