{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kicker": { "type": "string", "minLength": 2, "maxLength": 16, "description": "左上角标签" },
    "headline": { "type": "string", "minLength": 2, "maxLength": 16, "description": "标题" },
    "before_label": { "type": "string", "minLength": 1, "maxLength": 8, "description": "左卡标签，如「改造前」" },
    "before_items": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": { "type": "string", "minLength": 2, "maxLength": 16 },
      "description": "之前的状态，格式「要点|小注」"
    },
    "after_label": { "type": "string", "minLength": 1, "maxLength": 8, "description": "右卡标签，如「改造后」" },
    "after_items": {
      "type": "array", "minItems": 2, "maxItems": 3,
      "items": { "type": "string", "minLength": 2, "maxLength": 16 },
      "description": "之后的状态，格式「要点|小注」，按效果排序"
    },
    "note": { "type": "string", "minLength": 0, "maxLength": 22, "description": "注解（可留空）" }
  },
  "required": ["kicker", "headline", "before_label", "before_items", "after_label", "after_items"],
  "additionalProperties": false
}
