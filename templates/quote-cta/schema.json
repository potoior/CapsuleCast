{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kicker": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "description": "左上角标签"
    },
    "quote": {
      "type": "string",
      "minLength": 4,
      "maxLength": 32,
      "description": "金句（点题）"
    },
    "cta": {
      "type": "string",
      "minLength": 2,
      "maxLength": 14,
      "description": "行动号召"
    },
    "footnote": {
      "type": "string",
      "minLength": 2,
      "maxLength": 22,
      "description": "底部脚注（等宽）"
    },
    "variant": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1,
      "labels": [
        "居中引言",
        "明信片"
      ],
      "description": "版式变体（缺省按旁白哈希自动分配）"
    }
  },
  "required": [
    "kicker",
    "quote",
    "cta",
    "footnote"
  ],
  "additionalProperties": false
}