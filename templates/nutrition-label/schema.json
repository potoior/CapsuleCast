{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "人生成分表：营养成分表式戏仿，给一周或一份工作做成分检测",
  "properties": {
    "kicker": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "description": "顶部小引语，如「自我检测」"
    },
    "headline": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "description": "标签主标题，如「我的一周成分表」"
    },
    "subject": {
      "type": "string",
      "minLength": 2,
      "maxLength": 12,
      "description": "检测样本说明，如「样本：本人」"
    },
    "rows": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "description": "成分行，每项为「成分|占比%|小注」",
      "items": {
        "type": "string",
        "minLength": 4,
        "maxLength": 16,
        "description": "成分|占比%|小注"
      }
    },
    "daily_label": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "description": "底部每日建议摄入说明"
    },
    "note": {
      "type": "string",
      "minLength": 0,
      "maxLength": 22,
      "description": "可选脚注，留空则不显示"
    }
  },
  "required": ["kicker", "headline", "subject", "rows", "daily_label"],
  "additionalProperties": false
}
