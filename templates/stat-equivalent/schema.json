{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kicker": { "type": "string", "minLength": 2, "maxLength": 16, "description": "左上角标签" },
    "headline": { "type": "string", "minLength": 2, "maxLength": 16, "description": "标题" },
    "stat": { "type": "string", "minLength": 1, "maxLength": 16, "description": "要具象化的大数字（可带单位）" },
    "equals_label": { "type": "string", "minLength": 1, "maxLength": 6, "description": "等价引语，如「相当于」" },
    "items": {
      "type": "array", "minItems": 2, "maxItems": 3,
      "items": { "type": "string", "minLength": 2, "maxLength": 18 },
      "description": "等价物，格式「画面|小注」"
    },
    "note": { "type": "string", "minLength": 0, "maxLength": 22, "description": "注解（可留空）" }
  },
  "required": ["kicker", "headline", "stat", "equals_label", "items"],
  "additionalProperties": false
}
