{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kicker": { "type": "string", "minLength": 2, "maxLength": 16, "description": "左上角标签" },
    "headline": { "type": "string", "minLength": 2, "maxLength": 16, "description": "标题" },
    "subject": { "type": "string", "minLength": 1, "maxLength": 10, "description": "中央主体，短词" },
    "callouts": {
      "type": "array", "minItems": 3, "maxItems": 4,
      "items": { "type": "string", "minLength": 2, "maxLength": 16 },
      "description": "标注点，格式「部位|说明」"
    },
    "note": { "type": "string", "minLength": 0, "maxLength": 22, "description": "注解（可留空）" }
  },
  "required": ["kicker", "headline", "subject", "callouts"],
  "additionalProperties": false
}
