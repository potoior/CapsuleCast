{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kicker": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "description": "左上角标签"
    },
    "headline": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "description": "标题"
    },
    "segments": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 16
      },
      "description": "分段，格式「标签|占比%|小注」，占比合计尽量接近 100"
    },
    "total_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "description": "总量说明，如「一杯 22 元」"
    },
    "note": {
      "type": "string",
      "minLength": 0,
      "maxLength": 22,
      "description": "注解（可留空）"
    }
  },
  "required": [
    "kicker",
    "headline",
    "segments",
    "total_label"
  ],
  "additionalProperties": false
}