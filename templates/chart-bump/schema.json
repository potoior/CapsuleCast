{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kicker": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "headline": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "columns": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 6
      }
    },
    "series": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 20,
        "pattern": "^[^|]{1,12}\\|[1-4],[1-4],[1-4],[1-4]$"
      }
    },
    "note": {
      "type": "string",
      "minLength": 0,
      "maxLength": 22
    }
  },
  "required": ["kicker", "headline", "columns", "series"]
}
