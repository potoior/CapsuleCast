{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kicker": { "type": "string", "minLength": 2, "maxLength": 16, "description": "左上角标签" },
    "headline": { "type": "string", "minLength": 2, "maxLength": 16, "description": "标题" },
    "question": { "type": "string", "minLength": 4, "maxLength": 44, "description": "问题（含问号）" },
    "answer": { "type": "string", "minLength": 4, "maxLength": 48, "description": "答案" },
    "note": { "type": "string", "minLength": 0, "maxLength": 22, "description": "注解（可留空）" }
  },
  "required": ["kicker", "headline", "question", "answer"],
  "additionalProperties": false
}
