{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kicker": { "type": "string", "minLength": 2, "maxLength": 16, "description": "左上角标签" },
    "headline": { "type": "string", "minLength": 2, "maxLength": 16, "description": "标题" },
    "layer_labels": {
      "type": "array", "minItems": 3, "maxItems": 4,
      "items": { "type": "string", "minLength": 2, "maxLength": 10 },
      "description": "从左到右各层名称，如「输入层|隐藏层|隐藏层|输出层」"
    },
    "flow_note": { "type": "string", "minLength": 0, "maxLength": 20, "description": "高亮路径说明（可留空）" },
    "note": { "type": "string", "minLength": 0, "maxLength": 20, "description": "底部注解（可留空）" }
  },
  "required": ["kicker", "headline", "layer_labels"],
  "additionalProperties": false
}
