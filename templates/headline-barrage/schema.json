{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kicker": { "type": "string", "minLength": 2, "maxLength": 16, "description": "左上角标签" },
    "statements": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": { "type": "string", "minLength": 3, "maxLength": 14 },
      "description": "恰好三句短句，依次砸屏，最后一句是落点"
    },
    "subline": { "type": "string", "minLength": 0, "maxLength": 20, "description": "三句之后的收口副题（可留空）" },
    "note": { "type": "string", "minLength": 0, "maxLength": 22, "description": "注解（可留空）" }
  },
  "required": ["kicker", "statements"],
  "additionalProperties": false
}
