{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "kicker": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "headline": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "points": {
      "type": "array",
      "minItems": 4,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 16,
        "pattern": "^[^|]+\\|(?:1000|[0-9]{1,3})$"
      }
    },
    "peak": {
      "type": "string",
      "minLength": 2,
      "maxLength": 20
    },
    "note": {
      "type": "string",
      "minLength": 0,
      "maxLength": 22
    }
  },
  "required": ["kicker", "headline", "points", "peak"]
}
