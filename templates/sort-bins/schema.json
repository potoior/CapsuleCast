{
  "type": "object",
  "properties": {
    "kicker": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "description": "栏目标签，如「任务管理」「信息整理」"
    },
    "headline": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "description": "主标题，点出分类动作或收纳结果"
    },
    "source_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "description": "杂项来源胶囊文案，如「脑子里的杂念」"
    },
    "bins": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 4,
        "maxLength": 24,
        "description": "每个箱子格式为「箱名|条目1/条目2」，条目用 / 分隔"
      },
      "description": "两到三个收纳箱，每项为「箱名|条目/条目」竖线斜杠分隔"
    },
    "note": {
      "type": "string",
      "minLength": 0,
      "maxLength": 22,
      "description": "底部补充一句收尾话，可留空"
    }
  },
  "required": ["kicker", "headline", "source_label", "bins"],
  "additionalProperties": false
}
