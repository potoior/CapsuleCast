{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kicker": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "description": "左上角小标签，短促有力"
    },
    "headline": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "description": "大标题，一行说清悬念"
    },
    "question": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "description": "问题正文，居中展示"
    },
    "options": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 12,
        "description": "选项文案，对应 A/B/C"
      },
      "description": "三个候选选项"
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1,
      "description": "正确选项序号，1/2/3 对应 A/B/C"
    },
    "explain": {
      "type": "string",
      "minLength": 2,
      "maxLength": 18,
      "description": "揭晓后的解释短语"
    },
    "note": {
      "type": "string",
      "minLength": 0,
      "maxLength": 22,
      "description": "底部备注，可留空"
    }
  },
  "required": ["kicker", "headline", "question", "options", "answer", "explain"],
  "additionalProperties": false
}