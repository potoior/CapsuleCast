{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kicker": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "description": "左上角标签"
    },
    "headline": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "description": "标题"
    },
    "hypothesis": {
      "type": "string",
      "minLength": 4,
      "maxLength": 18,
      "description": "初始猜想"
    },
    "method": {
      "type": "string",
      "minLength": 4,
      "maxLength": 18,
      "description": "怎么做的实验"
    },
    "result": {
      "type": "string",
      "minLength": 4,
      "maxLength": 18,
      "description": "实测结果"
    },
    "twist": {
      "type": "string",
      "minLength": 4,
      "maxLength": 18,
      "description": "反常识反转"
    },
    "note": {
      "type": "string",
      "minLength": 0,
      "maxLength": 22,
      "description": "注解（可留空）"
    }
  },
  "required": [
    "kicker",
    "headline",
    "hypothesis",
    "method",
    "result",
    "twist"
  ],
  "additionalProperties": false
}