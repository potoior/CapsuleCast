{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kicker": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "headline": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "circles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 14,
        "pattern": "^[^|]+\\|[^|]+$"
      }
    },
    "center": {
      "type": "string",
      "minLength": 2,
      "maxLength": 18,
      "pattern": "^[^|]+\\|[^|]+$"
    },
    "note": {
      "type": "string",
      "minLength": 0,
      "maxLength": 22
    }
  },
  "required": ["kicker", "headline", "circles", "center"]
}
