{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["kicker", "headline", "from", "subject", "time", "lines"],
  "properties": {
    "kicker": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "headline": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "from": {
      "type": "string",
      "minLength": 4,
      "maxLength": 20,
      "pattern": "^[^|]+\\|[^|]+@[^|]+\\.[^|]+$"
    },
    "subject": {
      "type": "string",
      "minLength": 3,
      "maxLength": 22
    },
    "time": {
      "type": "string",
      "minLength": 3,
      "maxLength": 14
    },
    "lines": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 4,
        "maxLength": 32
      }
    },
    "note": {
      "type": "string",
      "minLength": 0,
      "maxLength": 22
    }
  }
}
