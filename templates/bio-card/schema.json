{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kicker": { "type": "string", "minLength": 2, "maxLength": 16, "description": "左上角标签" },
    "name": { "type": "string", "minLength": 2, "maxLength": 10, "description": "人物名（大字）" },
    "title": { "type": "string", "minLength": 2, "maxLength": 20, "description": "头衔/身份" },
    "tags": {
      "type": "array", "minItems": 2, "maxItems": 3,
      "items": { "type": "string", "minLength": 2, "maxLength": 12 },
      "description": "人物标签（2-3 个关键词）"
    },
    "quote": { "type": "string", "minLength": 4, "maxLength": 34, "description": "人物金句" },
    "note": { "type": "string", "minLength": 0, "maxLength": 22, "description": "编者按（可留空）" }
  },
  "required": ["kicker", "name", "title", "tags", "quote"],
  "additionalProperties": false
}
