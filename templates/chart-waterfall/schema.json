{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kicker": { "type": "string", "minLength": 2, "maxLength": 16, "description": "左上角标签" },
    "headline": { "type": "string", "minLength": 2, "maxLength": 16, "description": "标题" },
    "start_label": { "type": "string", "minLength": 1, "maxLength": 8, "description": "起点栏标签，如「税前」" },
    "start_value": { "type": "string", "minLength": 1, "maxLength": 12, "description": "起点数值（纯数字）" },
    "steps": {
      "type": "array", "minItems": 2, "maxItems": 5,
      "items": { "type": "string", "minLength": 2, "maxLength": 16 },
      "description": "逐级增减项，格式「项目|±数字」，负数递减正数递增"
    },
    "end_label": { "type": "string", "minLength": 1, "maxLength": 8, "description": "终值栏标签，如「到手」" },
    "note": { "type": "string", "minLength": 0, "maxLength": 22, "description": "注解（可留空）" }
  },
  "required": ["kicker", "headline", "start_label", "start_value", "steps", "end_label"],
  "additionalProperties": false
}
