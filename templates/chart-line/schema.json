{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kicker": { "type": "string", "minLength": 2, "maxLength": 16, "description": "左上角标签" },
    "headline": { "type": "string", "minLength": 2, "maxLength": 16, "description": "标题" },
    "series_label": { "type": "string", "minLength": 1, "maxLength": 8, "description": "数据系列名/单位，如「元/㎡」" },
    "points": {
      "type": "array", "minItems": 3, "maxItems": 6,
      "items": { "type": "string", "minLength": 2, "maxLength": 20 },
      "description": "数据点，按时间顺序，格式「标签|数值」（数值可带单位，如 2019|3.1万）"
    },
    "note": { "type": "string", "minLength": 0, "maxLength": 22, "description": "注解（可留空）" }
  },
  "required": ["kicker", "headline", "series_label", "points"],
  "additionalProperties": false
}
