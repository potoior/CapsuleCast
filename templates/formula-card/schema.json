{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kicker": { "type": "string", "minLength": 2, "maxLength": 16, "description": "左上角标签" },
    "headline": { "type": "string", "minLength": 2, "maxLength": 16, "description": "标题" },
    "terms": {
      "type": "array", "minItems": 2, "maxItems": 4,
      "items": { "type": "string", "minLength": 2, "maxLength": 16 },
      "description": "公式要素，格式「要素|小注」"
    },
    "operator": { "type": "string", "minLength": 1, "maxLength": 1, "description": "运算符：× + − ÷" },
    "result": { "type": "string", "minLength": 2, "maxLength": 16, "description": "结果，格式「结果|小注」" },
    "note": { "type": "string", "minLength": 0, "maxLength": 22, "description": "注解（可留空）" }
  },
  "required": ["kicker", "headline", "terms", "result"],
  "additionalProperties": false
}
