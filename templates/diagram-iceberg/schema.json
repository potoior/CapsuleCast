{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kicker": { "type": "string", "minLength": 2, "maxLength": 16, "description": "左上角标签" },
    "headline": { "type": "string", "minLength": 2, "maxLength": 16, "description": "标题" },
    "water_label": { "type": "string", "minLength": 1, "maxLength": 10, "description": "水面标签，如「你看到的」" },
    "above_items": {
      "type": "array", "minItems": 1, "maxItems": 2,
      "items": { "type": "string", "minLength": 2, "maxLength": 16 },
      "description": "水面上的表象，格式「现象|小注」"
    },
    "below_items": {
      "type": "array", "minItems": 2, "maxItems": 4,
      "items": { "type": "string", "minLength": 2, "maxLength": 16 },
      "description": "水面下的真相，格式「真相|小注」，按重要度排序"
    },
    "note": { "type": "string", "minLength": 0, "maxLength": 22, "description": "注解（可留空）" }
  },
  "required": ["kicker", "headline", "above_items", "below_items"],
  "additionalProperties": false
}
