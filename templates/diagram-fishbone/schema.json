{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kicker": { "type": "string", "minLength": 2, "maxLength": 16, "description": "左上角标签" },
    "headline": { "type": "string", "minLength": 2, "maxLength": 16, "description": "标题" },
    "problem": { "type": "string", "minLength": 2, "maxLength": 10, "description": "鱼头问题（≤10字）" },
    "bones": {
      "type": "array", "minItems": 4, "maxItems": 6,
      "items": { "type": "string", "minLength": 2, "maxLength": 16 },
      "description": "成因，格式「类别|原因」，上下交替排列"
    },
    "note": { "type": "string", "minLength": 0, "maxLength": 22, "description": "注解（可留空）" }
  },
  "required": ["kicker", "headline", "problem", "bones"],
  "additionalProperties": false
}
