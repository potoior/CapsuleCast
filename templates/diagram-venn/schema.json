{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kicker": { "type": "string", "minLength": 2, "maxLength": 16, "description": "左上角标签" },
    "headline": { "type": "string", "minLength": 2, "maxLength": 18, "description": "标题" },
    "left_label": { "type": "string", "minLength": 1, "maxLength": 6, "description": "左圆概念（≤6字）" },
    "left_sub": { "type": "string", "minLength": 0, "maxLength": 12, "description": "左圆小注" },
    "right_label": { "type": "string", "minLength": 1, "maxLength": 6, "description": "右圆概念（≤6字）" },
    "right_sub": { "type": "string", "minLength": 0, "maxLength": 12, "description": "右圆小注" },
    "both_label": { "type": "string", "minLength": 2, "maxLength": 8, "description": "交集处的高亮结论（≤8字）" },
    "note": { "type": "string", "minLength": 0, "maxLength": 22, "description": "注解（可留空）" }
  },
  "required": ["kicker", "headline", "left_label", "right_label", "both_label"],
  "additionalProperties": false
}
