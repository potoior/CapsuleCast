{
  "type": "object",
  "properties": {
    "kicker": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "description": "眉题小标签，2-16 字，如「职场实录」"
    },
    "headline": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "description": "主标题，2-16 字，概括这段对话的主题"
    },
    "messages": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "description": "聊天消息列表，2-4 条；每条首段为 L 或 R：L=左气泡，R=右气泡，竖线后为消息正文",
      "items": {
        "type": "string",
        "minLength": 4,
        "maxLength": 26,
        "description": "格式为「L|正文」或「R|正文」，首段指定气泡方向"
      }
    },
    "note": {
      "type": "string",
      "minLength": 0,
      "maxLength": 22,
      "description": "底部注释金句，0-22 字，可留空"
    }
  },
  "required": ["kicker", "headline", "messages"],
  "additionalProperties": false
}