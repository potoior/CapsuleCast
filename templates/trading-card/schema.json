{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kicker": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "headline": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "card_name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "description": "卡名|稀有度代号"
    },
    "rarity": {
      "type": "string",
      "minLength": 2,
      "maxLength": 8,
      "description": "稀有度名称"
    },
    "stats": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 12,
        "pattern": "^[^|]+\\|(?:100|[1-9]?[0-9])$",
        "description": "属性|数值，数值 0-100"
      }
    },
    "flavor": {
      "type": "string",
      "minLength": 4,
      "maxLength": 24,
      "description": "卡面描述一句话"
    },
    "note": {
      "type": "string",
      "maxLength": 22
    }
  },
  "required": ["kicker", "headline", "card_name", "rarity", "stats", "flavor"]
}
