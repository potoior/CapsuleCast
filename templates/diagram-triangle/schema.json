{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["kicker", "headline", "vertices", "center"],
  "properties": {
    "kicker": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "headline": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "vertices": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 12
      }
    },
    "center": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "note": {
      "type": "string",
      "minLength": 0,
      "maxLength": 22
    }
  }
}
