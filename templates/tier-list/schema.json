{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kicker": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "description": "左上角标签"
    },
    "headline": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "description": "标题"
    },
    "tiers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 18
      },
      "description": "档位行，格式「档名|评语」，S 档最神，往后递减"
    },
    "note": {
      "type": "string",
      "minLength": 0,
      "maxLength": 22,
      "description": "注解（可留空）"
    }
  },
  "required": [
    "kicker",
    "headline",
    "tiers"
  ],
  "additionalProperties": false
}