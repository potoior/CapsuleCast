{
  "type": "object",
  "properties": {
    "kicker": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "description": "栏目标签，如「运维夜话」"
    },
    "headline": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "description": "标题，如「凌晨三点的告警」"
    },
    "system_label": {
      "type": "string",
      "minLength": 2,
      "maxLength": 22,
      "description": "系统标识，如「order-service · prod」"
    },
    "metrics": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 4,
        "maxLength": 16,
        "description": "指标|数值|状态ok/warn/fail"
      },
      "description": "指标卡片列表，每项格式：指标|数值|状态（ok/warn/fail）"
    },
    "verdict": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "description": "告警结论，一句话运维判断"
    },
    "note": {
      "type": "string",
      "minLength": 0,
      "maxLength": 22,
      "description": "备注，可留空"
    }
  },
  "required": ["kicker", "headline", "system_label", "metrics", "verdict"],
  "additionalProperties": false
}
