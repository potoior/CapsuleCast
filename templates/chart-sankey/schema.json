{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "chart-sankey",
  "type": "object",
  "properties": {
    "kicker": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "headline": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "flows": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 24,
        "pattern": "^[^|]{1,20}\\|[^|]{1,20}\\|[1-9][0-9]{0,2}$",
        "description": "格式：来源|去向|数值，数值为 1-999 的整数"
      }
    },
    "note": {
      "type": "string",
      "minLength": 0,
      "maxLength": 22
    }
  },
  "required": ["kicker", "headline", "flows"],
  "additionalProperties": false
}
