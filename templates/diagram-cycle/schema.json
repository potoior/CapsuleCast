{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kicker": { "type": "string", "minLength": 2, "maxLength": 16, "description": "左上角标签" },
    "headline": { "type": "string", "minLength": 2, "maxLength": 16, "description": "标题" },
    "steps": {
      "type": "array", "minItems": 3, "maxItems": 5,
      "items": { "type": "string", "minLength": 2, "maxLength": 20 },
      "description": "循环环节（顺时针），格式「环节|小注」，如「更多用户|声量变大」"
    },
    "note": { "type": "string", "minLength": 0, "maxLength": 22, "description": "中心或底部注解（可留空）" }
  },
  "required": ["kicker", "headline", "steps"],
  "additionalProperties": false
}
