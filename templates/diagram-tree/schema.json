{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kicker": { "type": "string", "minLength": 2, "maxLength": 16, "description": "左上角标签" },
    "headline": { "type": "string", "minLength": 2, "maxLength": 16, "description": "标题" },
    "root": { "type": "string", "minLength": 2, "maxLength": 8, "description": "根概念（≤8字）" },
    "branches": {
      "type": "array", "minItems": 3, "maxItems": 5,
      "items": { "type": "string", "minLength": 2, "maxLength": 20 },
      "description": "分支，格式「分支名|小注」，首支自动高亮"
    },
    "note": { "type": "string", "minLength": 0, "maxLength": 22, "description": "注解（可留空）" }
  },
  "required": ["kicker", "headline", "root", "branches"],
  "additionalProperties": false
}
