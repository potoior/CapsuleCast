{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kicker": { "type": "string", "minLength": 2, "maxLength": 16, "description": "左上角标签" },
    "headline": { "type": "string", "minLength": 2, "maxLength": 16, "description": "标题" },
    "nodes": {
      "type": "array", "minItems": 3, "maxItems": 5,
      "items": { "type": "string", "minLength": 2, "maxLength": 20 },
      "description": "流程节点，格式「节点|小注」，如「输入文本|一句话」「算注意力|找重点」"
    },
    "note": { "type": "string", "minLength": 0, "maxLength": 24, "description": "底部注解（可留空）" }
  },
  "required": ["kicker", "headline", "nodes"],
  "additionalProperties": false
}
