{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "versus-table",
  "type": "object",
  "properties": {
    "kicker": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "headline": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "left": {
      "type": "string",
      "minLength": 2,
      "maxLength": 14,
      "pattern": "^[^|]+\\|[^|]+$"
    },
    "right": {
      "type": "string",
      "minLength": 2,
      "maxLength": 14,
      "pattern": "^[^|]+\\|[^|]+$"
    },
    "rows": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 6,
        "maxLength": 26,
        "pattern": "^[^|]+\\|[^|]+\\|[^|]+$"
      }
    },
    "verdict": {
      "type": "string",
      "minLength": 2,
      "maxLength": 18
    },
    "note": {
      "type": "string",
      "minLength": 0,
      "maxLength": 22
    }
  },
  "required": ["kicker", "headline", "left", "right", "rows", "verdict"],
  "additionalProperties": false
}
