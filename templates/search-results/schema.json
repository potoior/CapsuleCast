{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "search-results",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kicker": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "headline": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "query": {
      "type": "string",
      "minLength": 4,
      "maxLength": 22
    },
    "meta": {
      "type": "string",
      "minLength": 4,
      "maxLength": 26,
      "pattern": "^[^|]+\\|[^|]+$",
      "description": "格式「结果数|耗时」"
    },
    "results": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 8,
        "maxLength": 40,
        "pattern": "^[^|]+\\|[^|]+$",
        "description": "格式「标题|摘要」"
      }
    },
    "note": {
      "type": "string",
      "minLength": 0,
      "maxLength": 22
    }
  },
  "required": ["kicker", "headline", "query", "meta", "results"]
}
