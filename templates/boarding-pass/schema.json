{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kicker": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "headline": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "route": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 14,
        "pattern": "^[^|]{1,10}\\|[A-Z]{3}$"
      }
    },
    "flight": {
      "type": "string",
      "minLength": 3,
      "maxLength": 16,
      "pattern": "^[A-Za-z0-9]{2,10}\\|[0-2]\\d:[0-5]\\d$"
    },
    "gate": {
      "type": "string",
      "minLength": 2,
      "maxLength": 12,
      "pattern": "^[^|]{1,8}\\|[^|]{1,3}$"
    },
    "seat": {
      "type": "string",
      "minLength": 2,
      "maxLength": 12,
      "pattern": "^[^|]{1,8}\\|[^|]{1,3}$"
    },
    "note": {
      "type": "string",
      "minLength": 0,
      "maxLength": 22
    }
  },
  "required": ["kicker", "headline", "route", "flight", "gate", "seat"]
}
