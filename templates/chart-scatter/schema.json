{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kicker": { "type": "string", "minLength": 2, "maxLength": 16, "description": "左上角标签" },
    "headline": { "type": "string", "minLength": 2, "maxLength": 16, "description": "标题" },
    "x_label": { "type": "string", "minLength": 1, "maxLength": 10, "description": "横轴指标" },
    "y_label": { "type": "string", "minLength": 1, "maxLength": 10, "description": "纵轴指标" },
    "points": {
      "type": "array", "minItems": 3, "maxItems": 6,
      "items": { "type": "string", "minLength": 4, "maxLength": 20 },
      "description": "实体，格式「名字|X 0-100|Y 0-100」，首点高亮"
    },
    "note": { "type": "string", "minLength": 0, "maxLength": 22, "description": "注解（可留空）" }
  },
  "required": ["kicker", "headline", "x_label", "y_label", "points"],
  "additionalProperties": false
}
