{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pricing-table",
  "type": "object",
  "additionalProperties": true,
  "required": ["kicker", "headline", "tiers", "features"],
  "properties": {
    "kicker": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "headline": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "tiers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 14,
        "pattern": "^[^|]+\\|[^|]+$"
      }
    },
    "features": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 4,
        "maxLength": 16,
        "pattern": "^[^|]+\\|(?:[123](?:,[123])*)$"
      }
    },
    "note": {
      "type": "string",
      "minLength": 0,
      "maxLength": 22
    }
  }
}
