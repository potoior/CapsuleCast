{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kicker",
    "headline",
    "items",
    "total"
  ],
  "properties": {
    "kicker": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "headline": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "items": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 18,
        "pattern": "^.+\\|.+$"
      }
    },
    "total": {
      "type": "string",
      "minLength": 2,
      "maxLength": 18,
      "pattern": "^.+\\|.+$"
    },
    "note": {
      "type": "string",
      "minLength": 0,
      "maxLength": 22
    }
  }
}
