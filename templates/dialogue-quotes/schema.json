{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kicker": { "type": "string", "minLength": 2, "maxLength": 16, "description": "左上角标签" },
    "headline": { "type": "string", "minLength": 2, "maxLength": 16, "description": "标题" },
    "left_speaker": { "type": "string", "minLength": 2, "maxLength": 14, "description": "左方，格式「名字|身份小注」" },
    "left_quote": { "type": "string", "minLength": 4, "maxLength": 44, "description": "左方观点" },
    "right_speaker": { "type": "string", "minLength": 2, "maxLength": 14, "description": "右方，格式「名字|身份小注」" },
    "right_quote": { "type": "string", "minLength": 4, "maxLength": 44, "description": "右方观点" },
    "verdict": { "type": "string", "minLength": 2, "maxLength": 14, "description": "裁决/你的立场（可留空）" },
    "note": { "type": "string", "minLength": 0, "maxLength": 22, "description": "注解（可留空）" }
  },
  "required": ["kicker", "headline", "left_speaker", "left_quote", "right_speaker", "right_quote"],
  "additionalProperties": false
}
