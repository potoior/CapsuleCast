{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kicker": { "type": "string", "minLength": 2, "maxLength": 16, "description": "左上角标签" },
    "headline": { "type": "string", "minLength": 2, "maxLength": 16, "description": "标题" },
    "center_label": { "type": "string", "minLength": 0, "maxLength": 8, "description": "环中心大字（可留空，如「30元」「100%」）" },
    "parts": {
      "type": "array", "minItems": 3, "maxItems": 5,
      "items": { "type": "string", "minLength": 2, "maxLength": 18 },
      "description": "占比，格式「标签|百分比」如「原料|40%」，合计≈100"
    },
    "note": { "type": "string", "minLength": 0, "maxLength": 22, "description": "注解（可留空）" }
  },
  "required": ["kicker", "headline", "parts"],
  "additionalProperties": false
}
