{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kicker": { "type": "string", "minLength": 2, "maxLength": 16, "description": "左上角标签" },
    "headline": { "type": "string", "minLength": 2, "maxLength": 16, "description": "标题" },
    "events": {
      "type": "array", "minItems": 3, "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 8, "description": "阶段/年份" },
          "text": { "type": "string", "minLength": 2, "maxLength": 18, "description": "事件描述" }
        },
        "required": ["label", "text"],
        "additionalProperties": false
      },
      "description": "事件（3-4 个）"
    }
  },
  "required": ["kicker", "headline", "events"],
  "additionalProperties": false
}
