{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "词语槽翻转机",
  "type": "object",
  "description": "句子里一个词槽依次翻转，一句话讲出三种阶段。",
  "properties": {
    "kicker": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "description": "左上角小标签，短促点题。"
    },
    "headline": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "description": "衬线大标题，一句概括。"
    },
    "sentence": {
      "type": "string",
      "minLength": 4,
      "maxLength": 22,
      "description": "主句，用[]括住要翻转的词，如：我[想要]一台新电脑。"
    },
    "variants": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "description": "三个翻转形态，每项为“词|注释”，注释可省略，如：买了|冲动期。"
    },
    "note": {
      "type": "string",
      "minLength": 0,
      "maxLength": 22,
      "description": "底部备注，可留空。"
    }
  },
  "required": ["kicker", "headline", "sentence", "variants"],
  "additionalProperties": false
}
