{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "kicker": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "headline": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "rows": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 16
      }
    },
    "total": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "seller": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "note": {
      "type": "string",
      "minLength": 0,
      "maxLength": 22
    }
  },
  "required": ["kicker", "headline", "rows", "total", "seller"],
  "additionalProperties": false
}
