{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sticky-notes",
  "type": "object",
  "properties": {
    "kicker": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "headline": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "notes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 22
      }
    },
    "note": {
      "type": "string",
      "minLength": 0,
      "maxLength": 22
    }
  },
  "required": ["kicker", "headline", "notes"],
  "additionalProperties": false
}
